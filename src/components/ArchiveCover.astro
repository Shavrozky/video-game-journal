---
interface Props {
  title: string;
  cover?: string;
  platform?: string;
  class?: string;
}

const {
  title,
  cover,
  platform,
  class: className = '',
} = Astro.props;
---

<div
  class:list={[
    'relative aspect-[3/4] overflow-hidden bg-[#252a2a]',
    className,
  ]}
>
  {
    cover ? (
      <img
        src={cover}
        alt={`Ilustrasi arsip untuk ${title}`}
        loading="lazy"
        class="h-full w-full object-cover"
      />
    ) : (
      <div class="relative flex h-full flex-col justify-between overflow-hidden bg-gradient-to-br from-[#343735] via-[#252a2a] to-[#492e2e] p-3 text-[#eee4d6]">
        <div class="pointer-events-none absolute -right-7 top-1/3 h-32 w-32 rotate-45 border border-white/15"></div>
        <div class="pointer-events-none absolute right-2 top-1/2 h-20 w-20 rotate-45 border border-white/10"></div>

        <span class="relative font-mono text-[7px] uppercase tracking-[0.2em] text-white/60">
          Personal Game Archive
        </span>

        <strong class="relative font-serif text-base leading-tight text-white">
          {title}
        </strong>

        <span class="relative border-t border-white/20 pt-2 font-mono text-[8px] uppercase tracking-wider text-white/60">
          Editorial Record
        </span>
      </div>
    )
  }

  {
    platform && (
      <span class="absolute left-1.5 top-1.5 bg-black/80 px-1.5 py-0.5 font-mono text-[8px] font-bold text-white">
        {platform}
      </span>
    )
  }
</div>