
---
import { getCollection } from 'astro:content';

import NotebookLayout from '../layouts/NotebookLayout.astro';
import ArchiveCover from '../components/ArchiveCover.astro';
import JournalIcon from '../components/ui/JournalIcon.astro';

import {
  gameForEntry,
  journalPath,
  sortJournals,
} from '../lib/journal';

const allLogs = sortJournals(
  await getCollection('journal')
);

const featuredLog =
  allLogs.find(
    (entry) => entry.data.entryType === 'session'
  ) ??
  allLogs[0] ??
  null;

const featuredGame = featuredLog
  ? gameForEntry(featuredLog)
  : null;

const featuredCover = '/images.jpg';

const featuredExcerpt = featuredLog
  ? featuredLog.data.excerpt ??
    `Sebuah catatan tentang ${featuredLog.data.game} dan pengalaman yang tertinggal setelah bermain.`
  : '';
---

<NotebookLayout
  activeTab="logs"
  headTitle="Field Journal — Personal Archive"
  kicker="Personal Archive"
  kickerSuffix="Vol. 01 / Home"
  title="FIELD JOURNAL"
  subtitle="Catatan pengalaman bermain dan cerita yang ingin disimpan."
  footerLabel="Personal Archive // Home"
  pageLabel="Home / 001"
  sideIndexLabel="JOURNAL // 01"
>
  <main class="mx-auto w-full max-w-5xl pb-6">

    <!-- HERO -->
    <header class="pb-8 pt-1 sm:pb-9 md:pt-3">

      <p
        class="mb-3 flex items-center gap-3 font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-[#8e3029]"
      >
        <span class="h-px w-7 bg-[#8e3029]"></span>
        A Personal Video Game Archive
      </p>

      <p
        class="max-w-3xl font-serif text-[clamp(2.5rem,5vw,4rem)] font-bold leading-[1.08] tracking-tight text-[#302820]"
      >
        Every game
        <span class="font-normal italic text-[#8e3029]">
          leaves a story.
        </span>
      </p>

      <p
        class="mt-4 max-w-2xl font-serif text-base leading-relaxed text-[#706457] md:text-lg"
      >
        Tempat menyimpan kesan, cerita, dan kenangan
        dari game yang pernah dimainkan.
        Tidak semuanya harus ditamatkan untuk bisa dikenang.
      </p>

    </header>

    <!-- LATEST FIELD NOTE -->
    <section
      aria-labelledby="featured-heading"
      class="border-t border-[#cfc5b4] py-8 md:py-9"
    >

      <div class="mb-5 flex flex-wrap items-end justify-between gap-3">

        <div>
          <p
            class="mb-1 font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-[#8e3029]"
          >
            01 / The Journal
          </p>

          <h2
            id="featured-heading"
            class="font-serif text-2xl font-bold text-[#302820] md:text-3xl"
          >
            Latest Field Note
          </h2>
        </div>

        <span
          class="font-mono text-[10px] uppercase tracking-wider text-[#897b69]"
        >
          Featured Entry
        </span>

      </div>

      {
        featuredLog ? (
          <a
            href={journalPath(featuredLog)}
            class="group grid overflow-hidden border border-[#d2c5b3] bg-[#f4ede0] transition-colors duration-200 hover:border-[#8e3029] sm:grid-cols-[205px_minmax(0,1fr)]"
          >

            <!-- ARTWORK -->
            <div
              class="flex items-center justify-center border-b border-[#d2c5b3] bg-[#e9dfcf] px-6 py-7 sm:border-b-0 sm:border-r"
            >
              <ArchiveCover
                title={featuredLog.data.game}
                cover={featuredCover}
                platform={featuredLog.data.platform}
                class="w-full max-w-[165px] -rotate-2 border-[5px] border-white shadow-lg transition-transform duration-200 group-hover:rotate-0"
              />
            </div>

            <!-- JOURNAL DETAIL -->
            <div
              class="flex min-w-0 flex-col justify-center p-6 sm:p-7 md:p-8"
            >

              <p
                class="font-mono text-[10px] font-bold uppercase tracking-[0.13em] text-[#8e3029]"
              >
                {
                  featuredLog.data.entryType === 'session'
                    ? 'Session Journal'
                    : 'Archive Note'
                }

                <span class="mx-2 text-[#b5a796]">/</span>

                {featuredLog.data.game}
              </p>

              <h3
                class="mt-3 max-w-2xl font-serif text-[clamp(1.65rem,3vw,2.35rem)] font-bold leading-[1.15] text-[#302820] group-hover:text-[#8e3029]"
              >
                {featuredLog.data.title}
              </h3>

              <p
                class="mt-4 line-clamp-3 max-w-xl font-serif text-base leading-relaxed text-[#6f6356]"
              >
                {featuredExcerpt}
              </p>

              <span
                class="mt-6 inline-flex items-center gap-2 self-start border-b border-[#8e3029] pb-1 font-mono text-[10px] font-bold uppercase tracking-[0.13em] text-[#8e3029]"
              >
                Read Field Note
                <JournalIcon name="arrow" size={13} />
              </span>

            </div>
          </a>
        ) : (
          <div
            class="border border-dashed border-[#cfc5b4] bg-[#f8f4ec] px-6 py-10"
          >
            <p class="font-serif text-lg text-[#706457]">
              Belum ada catatan.
              Cerita pertama akan muncul di sini.
            </p>
          </div>
        )
      }

    </section>

    <!-- COLLECTION NAVIGATION -->
    <section
      aria-labelledby="explore-heading"
      class="border-t border-[#cfc5b4] py-8 md:py-9"
    >

      <div class="mb-5">

        <p
          class="mb-1 font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-[#8e3029]"
        >
          02 / The Collection
        </p>

        <h2
          id="explore-heading"
          class="font-serif text-2xl font-bold text-[#302820] md:text-3xl"
        >
          Explore the Archive
        </h2>

      </div>

      <div class="grid gap-3 sm:grid-cols-2">

        <!-- MY BACKLOG -->
        <a
          href="/backlog"
          class="group flex items-center gap-4 border border-[#d2c5b3] bg-[#f5efe4] p-5 transition-colors hover:border-[#8e3029] hover:bg-[#eee4d5]"
        >

          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center border border-[#d0c0ac] text-[#8e3029]"
          >
            <JournalIcon name="backlog" size={19} />
          </span>

          <span class="min-w-0 flex-1">

            <span
              class="block font-serif text-xl font-bold text-[#302820]"
            >
              My Backlog
            </span>

            <span
              class="mt-1 block font-serif text-sm text-[#72675a]"
            >
              Koleksi dan progres bermain
            </span>

          </span>

          <JournalIcon
            name="arrow"
            size={15}
            class="shrink-0 text-[#8e3029] transition-transform group-hover:translate-x-1"
          />

        </a>

        <!-- GAME CATALOG -->
        <a
          href="/catalog"
          class="group flex items-center gap-4 border border-[#d2c5b3] bg-[#f5efe4] p-5 transition-colors hover:border-[#8e3029] hover:bg-[#eee4d5]"
        >

          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center border border-[#d0c0ac] text-[#8e3029]"
          >
            <JournalIcon name="catalog" size={19} />
          </span>

          <span class="min-w-0 flex-1">

            <span
              class="block font-serif text-xl font-bold text-[#302820]"
            >
              Game Catalog
            </span>

            <span
              class="mt-1 block font-serif text-sm text-[#72675a]"
            >
              Cari permainan berikutnya
            </span>

          </span>

          <JournalIcon
            name="arrow"
            size={15}
            class="shrink-0 text-[#8e3029] transition-transform group-hover:translate-x-1"
          />

        </a>

      </div>

    </section>

    <!-- CLOSING -->
    <footer
      class="border-t border-dashed border-[#cfc5b4] pt-5 text-center"
    >
      <p class="font-serif text-sm italic text-[#807363]">
        Not every game needs to be finished to be remembered.
      </p>
    </footer>

  </main>
</NotebookLayout>
