---
/**
 * /catalog/[appId] — one Steam catalog record.
 *
 * Rendered on demand (Node adapter), so 11k detail pages are never
 * pre-built. Unknown or malformed AppIDs return a real 404 status.
 *
 * Deliberately separate from the personal `/games/[id]` profile route.
 */

import NotebookLayout from '../../layouts/NotebookLayout.astro';
import JournalIcon from '../../components/ui/JournalIcon.astro';

import { getCatalog, getGame } from '../../lib/catalog/store';
import { queryCatalog } from '../../lib/catalog/query';

export const prerender = false;

const rawId = Astro.params.appId ?? '';
const appId = Number(rawId);

const validId = /^\d+$/.test(rawId) && Number.isSafeInteger(appId) && appId > 0;

const catalog = await getCatalog();
const datasetReady = catalog.status === 'ready';

const game = validId && datasetReady ? await getGame(appId) : null;

if (!validId || (datasetReady && !game)) {
  Astro.response.status = 404;
}

/**
 * Related records. A broad genre like "Action" matches thousands of unrelated
 * games, so the strongest community tag (e.g. "Survival Horror") is preferred
 * when the record has one, falling back to the primary genre.
 */
const relatedFilter = game
  ? game.tags.find((tag) => catalog.tags.some((facet) => facet.name === tag)) ?? ''
  : '';

const relatedLabel = relatedFilter
  ? relatedFilter
  : (game?.genres[0] ?? '');

const related =
  game && datasetReady
    ? queryCatalog(catalog, {
        search: '',
        genre: relatedFilter ? '' : (game.genres[0] ?? ''),
        tag: relatedFilter,
        year: null,
        // Most-reviewed first: with a broad filter, alphabetical order would
        // surface obscure entries and hide the notable ones.
        sort: 'reviews_desc',
        page: 1,
        pageSize: 7,
      }).results
        .filter((entry) => entry.appId !== game.appId)
        .slice(0, 6)
    : [];

const releaseLabel = game?.releaseDate
  ? new Date(`${game.releaseDate}T00:00:00Z`).toLocaleDateString('en-GB', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    })
  : 'Date not recorded';

const reviewTotal =
  game && game.positiveReviews !== null
    ? game.positiveReviews + (game.negativeReviews ?? 0)
    : null;

const positiveShare =
  game && game.positiveReviews !== null && reviewTotal
    ? Math.round((game.positiveReviews / reviewTotal) * 100)
    : null;

const detailRows = game
  ? [
      { label: 'Release Date', value: releaseLabel },
      { label: 'Developer', value: game.developers.length ? game.developers.join(', ') : 'Not recorded' },
      { label: 'Publisher', value: game.publishers.length ? game.publishers.join(', ') : 'Not recorded' },
      {
        label: 'Price (snapshot)',
        value: game.price === null ? 'Not recorded' : game.price === 0 ? 'Free' : `$${game.price.toFixed(2)}`,
      },
      { label: 'Steam AppID', value: String(game.appId) },
    ]
  : [];

const headings = {
  title: game ? `${game.name} — PC Game Database` : 'Record not found — PC Game Database',
};
---

<NotebookLayout
  activeTab="catalog"
  headTitle={headings.title}
  kicker="Reference Archive"
  kickerSuffix="Vol. 02 / Catalog Record"
  title="CATALOG RECORD"
  subtitle="Detail entry from the local Steam dataset snapshot. This is a reference record, not a personal field log."
  footerLabel="Catalog Index // Record Detail"
  pageLabel={game ? `App ${game.appId}` : 'Unresolved'}
  sideIndexLabel="CATALOG // PC"
>
  <article class="mx-auto max-w-6xl space-y-9">
    <!-- BREADCRUMB -->
    <nav
      aria-label="Breadcrumb"
      class="flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-wider text-paper-muted"
    >
      <a href="/catalog" class="hover:underline">PC Game Database</a>

      <span>/</span>

      <span class="font-bold text-neutral-900">
        {game ? game.name : 'Not Found'}
      </span>
    </nav>

    {
      !game && (
        <section class="space-y-5 border-2 border-[#8e3029] bg-[#f6e9e5] p-7">
          <h2 class="flex items-center gap-2 font-mono text-sm font-bold uppercase tracking-wider text-[#8e3029]">
            <JournalIcon name="status" size={16} />
            {datasetReady ? 'Record Not Found' : 'Dataset Not Imported'}
          </h2>

          <p class="max-w-2xl font-serif text-base leading-relaxed text-neutral-800">
            {datasetReady
              ? `AppID "${rawId}" is not present in the local Steam catalog snapshot. The record may have been excluded (non-Windows platform) or the AppID may be incorrect.`
              : 'The local catalog dataset has not been generated yet. Run the importer, then reload this page.'}
          </p>

          {
            !datasetReady && (
              <pre class="overflow-x-auto border border-[#d8c9c2] bg-[#fbf7f4] p-3 font-mono text-[11px] text-neutral-800">
                npm run catalog:import
              </pre>
            )
          }

          <div class="flex flex-wrap gap-3">
            <a
              href="/catalog"
              class="inline-flex items-center gap-2 border border-[#8e3029] px-4 py-2 font-mono text-[10px] font-bold uppercase tracking-wider text-[#8e3029] hover:bg-[#8e3029] hover:text-[#fbf7ef]"
            >
              <JournalIcon name="arrow" size={12} class="rotate-180" />
              Back to Catalog
            </a>
          </div>
        </section>
      )
    }

    {
      game && (
        <>
          <section class="grid grid-cols-1 gap-8 border-b border-dashed border-[#cfc7b8] pb-8 md:grid-cols-[300px_minmax(0,1fr)]">
            <div>
              <div class="relative aspect-[460/215] w-full overflow-hidden border-4 border-white bg-[#252a2a] shadow-md">
                <!-- Placeholder layer. Hidden whenever artwork exists so it
                     cannot paint over (or be announced beneath) the image. -->
                <div
                  class="flex h-full w-full flex-col justify-between bg-gradient-to-br from-[#343735] via-[#252a2a] to-[#492e2e] p-4 text-[#eee4d6]"
                  data-detail-cover-fallback
                  hidden={!!game.headerImage}
                >
                  <span class="font-mono text-[8px] uppercase tracking-[0.2em] text-white/55">
                    Steam Archive / No Artwork
                  </span>

                  <strong class="font-serif text-lg leading-tight text-white">{game.name}</strong>

                  <span class="border-t border-white/20 pt-2 font-mono text-[8px] uppercase tracking-wider text-white/50">
                    App {game.appId}
                  </span>
                </div>

                {
                  game.headerImage && (
                    <img
                      src={game.headerImage}
                      alt={`Steam header artwork for ${game.name}`}
                      class="absolute inset-0 h-full w-full object-cover"
                      referrerpolicy="no-referrer"
                      data-detail-cover
                    />
                  )
                }
              </div>

              <p class="mt-2 font-mono text-[8px] uppercase leading-relaxed tracking-wider text-paper-muted">
                Header artwork © the respective publisher / Valve. Served from
                the Steam CDN referenced by the dataset.
              </p>
            </div>

            <div class="min-w-0">
              <div class="mb-3 flex flex-wrap items-center gap-3 font-mono text-[10px] uppercase tracking-wider text-paper-muted">
                <span>AppID {game.appId}</span>
                <span class="h-3 w-px bg-[#cfc7b8]"></span>
                <span>{game.releaseYear ?? 'Year N/A'}</span>
                {game.platforms.windows && <span class="text-red-800">Windows</span>}
              </div>

              <h2 class="font-serif text-4xl font-bold leading-tight text-neutral-950 md:text-5xl">
                {game.name}
              </h2>

              {
                game.genres.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {game.genres.map((genre) => (
                      <a
                        href={`/catalog?genre=${encodeURIComponent(genre)}`}
                        class="border border-[#c4b9a5] bg-[#efe8da] px-2.5 py-1 font-mono text-[9px] uppercase tracking-wider text-neutral-700 hover:border-red-800 hover:text-red-900"
                      >
                        {genre}
                      </a>
                    ))}
                  </div>
                )
              }

              <p class="mt-5 max-w-3xl font-serif text-lg leading-relaxed text-neutral-700">
                {game.shortDescription || 'No short description was recorded for this title in the snapshot.'}
              </p>

              <div class="mt-7 grid grid-cols-2 gap-5 border-t border-[#d6cdbb] pt-5 font-mono text-[10px] md:grid-cols-3">
                {
                  detailRows.map((row) => (
                    <div>
                      <p class="uppercase text-paper-muted">{row.label}</p>
                      <p class="mt-1 font-bold text-neutral-900">{row.value}</p>
                    </div>
                  ))
                }
              </div>

              <div class="mt-7 flex flex-wrap items-center gap-3 border-t border-[#d6cdbb] pt-5">
                <a
                  href={game.steamUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 border border-[#8b7660] bg-[#39312b] px-4 py-2.5 font-mono text-[10px] font-bold uppercase tracking-wider text-[#fbf7ef] transition-colors hover:bg-[#8e3029]"
                >
                  <JournalIcon name="platform" size={13} />
                  Open Steam Store
                  <JournalIcon name="arrow" size={12} />
                </a>

                <a
                  href="/catalog"
                  class="inline-flex items-center gap-2 border border-[#c4b9a5] px-4 py-2.5 font-mono text-[10px] font-bold uppercase tracking-wider text-neutral-700 hover:bg-[#dfd6c6]"
                >
                  <JournalIcon name="arrow" size={12} class="rotate-180" />
                  Back to Catalog
                </a>
              </div>
            </div>
          </section>

          <div class="grid grid-cols-1 items-start gap-8 xl:grid-cols-[minmax(0,1fr)_300px]">
            <div class="space-y-9">
              <!-- SCORE METADATA -->
              <section class="space-y-4">
                <div class="flex items-center gap-3 border-b border-[#d6cdbb] pb-3">
                  <JournalIcon name="status" size={16} />

                  <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-neutral-900">
                    Recorded Metrics
                  </h3>

                  <span class="ml-auto font-mono text-[10px] text-paper-muted">
                    Snapshot values
                  </span>
                </div>

                <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                  <div class="border border-[#cfc4b0] bg-[#f1ebdf] p-4">
                    <p class="font-mono text-[9px] uppercase tracking-wider text-paper-muted">
                      Metacritic Score
                    </p>

                    <p class="mt-2 font-serif text-3xl font-bold text-neutral-950">
                      {game.metacriticScore ?? '—'}
                    </p>

                    <p class="mt-1 font-mono text-[8px] uppercase leading-relaxed tracking-wider text-paper-muted">
                      {game.metacriticScore === null
                        ? 'Not present in the dataset for this AppID.'
                        : 'Taken from the dataset metacritic_score field.'}
                    </p>
                  </div>

                  <div class="border border-[#cfc4b0] bg-[#f1ebdf] p-4">
                    <p class="font-mono text-[9px] uppercase tracking-wider text-paper-muted">
                      Steam Reviews
                    </p>

                    <p class="mt-2 font-serif text-3xl font-bold text-neutral-950">
                      {reviewTotal === null ? '—' : reviewTotal.toLocaleString('en-US')}
                    </p>

                    <p class="mt-1 font-mono text-[8px] uppercase leading-relaxed tracking-wider text-paper-muted">
                      {positiveShare === null
                        ? 'No review counts recorded.'
                        : `${positiveShare}% positive of recorded votes.`}
                    </p>
                  </div>

                  <div class="border border-[#cfc4b0] bg-[#f1ebdf] p-4">
                    <p class="font-mono text-[9px] uppercase tracking-wider text-paper-muted">
                      Platforms
                    </p>

                    <ul class="mt-2 space-y-1 font-mono text-[10px] uppercase tracking-wider">
                      <li class:list={['flex items-center gap-2', !game.platforms.windows && 'text-neutral-400']}>
                        <JournalIcon name="platform" size={12} />
                        Windows {game.platforms.windows ? '· supported' : '· not listed'}
                      </li>
                      <li class:list={['flex items-center gap-2', !game.platforms.mac && 'text-neutral-400']}>
                        <JournalIcon name="platform" size={12} />
                        macOS {game.platforms.mac ? '· supported' : '· not listed'}
                      </li>
                      <li class:list={['flex items-center gap-2', !game.platforms.linux && 'text-neutral-400']}>
                        <JournalIcon name="platform" size={12} />
                        Linux {game.platforms.linux ? '· supported' : '· not listed'}
                      </li>
                    </ul>
                  </div>
                </div>
              </section>

              <!-- COMMUNITY TAGS -->
              {
                game.tags.length > 0 && (
                  <section class="space-y-4">
                    <div class="flex items-center gap-3 border-b border-[#d6cdbb] pb-3">
                      <JournalIcon name="bookmark" size={15} />

                      <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-neutral-900">
                        Community Tags
                      </h3>
                    </div>

                    <div class="flex flex-wrap gap-2">
                      {game.tags.map((tag) => (
                        <span class="border border-[#d0c6b4] bg-[#f7f3e9] px-2.5 py-1 font-mono text-[9px] uppercase tracking-wider text-neutral-600">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </section>
                )
              }
            </div>

            <!-- SIDEBAR -->
            <aside class="space-y-5">
              <section class="border border-[#cfc4b0] bg-[#f1ebdf] p-5">
                <h3 class="font-mono text-[10px] font-bold uppercase tracking-wider text-neutral-900">
                  Registry Note
                </h3>

                <p class="mt-3 font-serif text-sm leading-relaxed text-neutral-700">
                  This record belongs to the global Steam catalog. It says
                  nothing about whether the game has been played, logged, or
                  added to the personal Backlog Shelf.
                </p>

                <div class="mt-4 space-y-2 border-t border-dashed border-[#d7cebc] pt-3">
                  <a
                    href="/backlog"
                    class="flex items-center justify-between gap-2 font-mono text-[9px] font-bold uppercase tracking-wider text-amber-900 hover:underline"
                  >
                    Personal Backlog
                    <JournalIcon name="arrow" size={11} />
                  </a>

                  <a
                    href="/"
                    class="flex items-center justify-between gap-2 font-mono text-[9px] font-bold uppercase tracking-wider text-amber-900 hover:underline"
                  >
                    Field Logs
                    <JournalIcon name="arrow" size={11} />
                  </a>
                </div>
              </section>

              {
                related.length > 0 && (
                  <section class="border border-[#cfc4b0] bg-[#f8f5ef] p-5">
                    <h3 class="font-mono text-[10px] font-bold uppercase tracking-wider text-neutral-900">
                      Related Records
                    </h3>

                    <p class="mt-1 font-mono text-[9px] uppercase text-paper-muted">
                      {relatedFilter ? 'Tag' : 'Genre'} / {relatedLabel}
                    </p>

                    <div class="mt-4 space-y-2">
                      {related.map((entry) => (
                        <a
                          href={`/catalog/${entry.appId}`}
                          class="flex items-center justify-between gap-3 border-b border-[#d7cebc] py-2 font-serif text-sm text-neutral-800 hover:text-red-900"
                        >
                          <span class="line-clamp-1">{entry.name}</span>

                          <span class="shrink-0 font-mono text-[8px] text-paper-muted">
                            {entry.releaseYear ?? '—'}
                          </span>
                        </a>
                      ))}
                    </div>

                    <a
                      href={
                        relatedFilter
                          ? `/catalog?tag=${encodeURIComponent(relatedFilter)}`
                          : `/catalog?genre=${encodeURIComponent(game.genres[0] ?? '')}`
                      }
                      class="mt-3 inline-flex items-center gap-1 font-mono text-[9px] font-bold uppercase tracking-wider text-amber-900 hover:underline"
                    >
                      Browse {relatedFilter ? 'tag' : 'genre'}
                      <JournalIcon name="arrow" size={11} />
                    </a>
                  </section>
                )
              }

              <section class="border border-dashed border-[#cfc4b0] bg-[#f8f5ee] p-5">
                <h3 class="font-mono text-[10px] font-bold uppercase tracking-wider text-neutral-900">
                  Local API
                </h3>

                <p class="mt-2 font-mono text-[9px] leading-relaxed text-paper-muted">
                  This record is also available as JSON:
                </p>

                <a
                  href={`/api/games/${game.appId}`}
                  class="mt-2 block break-all font-mono text-[10px] text-amber-900 hover:underline"
                >
                  /api/games/{game.appId}
                </a>
              </section>
            </aside>
          </div>

          <div class="border-t border-dashed border-[#cfc7b8] pt-5">
            <a
              href="/catalog"
              class="inline-flex items-center gap-2 font-mono text-[10px] font-bold uppercase text-amber-900 hover:underline"
            >
              <JournalIcon name="arrow" size={13} class="rotate-180" />
              Kembali ke Catalog
            </a>
          </div>
        </>
      )
    }
  </article>
</NotebookLayout>

<script>
  // Hide a failed header image so the typeset placeholder underneath shows.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLImageElement>('[data-detail-cover]').forEach((img) => {
      if (img.dataset.guarded === 'true') return;
      img.dataset.guarded = 'true';

      img.addEventListener('error', () => {
        img.remove();
        img.parentElement?.querySelector('[data-detail-cover-fallback]')?.removeAttribute('hidden');
      });
    });
  });
</script>
